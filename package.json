{
  "name": "medal-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "three.js + Rapier で動くメダルゲーム(コインプッシャー)。UI は React。",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --var ENVIRONMENT:dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:create": "wrangler d1 create medal_web",
    "db:migrate": "wrangler d1 migrations apply medal_web --local",
    "db:migrate:remote": "wrangler d1 migrations apply medal_web --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "hono": "^4.13.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "lil-gui": "^0.21.0",
    "stats.js": "^0.17.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.130.0"
  }
}
