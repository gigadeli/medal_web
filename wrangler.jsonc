/**
 * Cloudflare Workers の設定 (DESIGN_SERVER.md §10)
 *
 * ■ 最初に1回だけ必要なこと
 *   npx wrangler d1 create medal_web
 *   → 出力された database_id を下に貼る
 *   npx wrangler d1 migrations apply medal_web --local
 *
 * ■ Turnstile (任意・DESIGN_SERVER.md §15-3)
 *   npx wrangler secret put TURNSTILE_SECRET
 *   シークレットが無ければ検証はスキップされる。開発中はそれでよい
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medal-web",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-10",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // ここが要点 (§2)。3.7MB の JS と 7.1MB の mp4 で Worker を起動しない。
    // Worker が動くのは /api/* だけになる
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medal_web",
      "database_id": "0f71529b-7df5-4b38-9ce2-259087502608",
      "migrations_dir": "migrations"
    }
  ],

  // §4.3: これはロケーションごと・permissive な「乱打を止める蓋」であって、
  // 不正の検出手段ではない。period は 10 か 60 しか取れない
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "TRANSFER_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // §8.5: ランキングの分布表を作り直す。
  // 毎リクエストで COUNT(*) すると無料枠の行読み取りが即枯れる (§15-7)
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "vars": { "ENVIRONMENT": "production" },
  "observability": { "enabled": true }
}
